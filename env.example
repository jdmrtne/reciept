# Copy to .env.local and fill in. Vite only exposes variables that start with VITE_.
# Both values are SAFE to ship in the browser. NEVER put a service_role / secret key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
