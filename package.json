{
  "name": "receipt-photobooth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "bridge": "node bridge/server.mjs",
    "find-printer": "node bridge/find-printer.mjs",
    "list-printers": "node bridge/list-printers.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^5.0.2"
  }
}
